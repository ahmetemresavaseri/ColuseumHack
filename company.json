{
  "project": "Atrium Cleaning Quote Engine",
  "version": "hackathon_mvp",
  "currency": "CHF",
  "purpose": "Estimate cleaning price and time during a live AI phone call.",

  "required_slots": [
    "service_type",
    "area_m2",
    "rooms",
    "bathrooms",
    "urgency",
    "email"
  ],

  "optional_slots": [
    "condition",
    "addons",
    "preferred_date",
    "postcode"
  ],

  "default_values": {
    "condition": "normal",
    "bathrooms": 1,
    "urgency": "standard",
    "addons": []
  },

  "service_types": {
    "regular_cleaning": {
      "label": "Regular home cleaning",
      "base_fee": 60,
      "price_per_m2": 1.2,
      "price_per_room": 20,
      "price_per_bathroom": 35,
      "minutes_per_m2": 2,
      "minutes_per_room": 15,
      "minutes_per_bathroom": 25,
      "minimum_price": 120
    },
    "deep_cleaning": {
      "label": "Deep cleaning",
      "base_fee": 100,
      "price_per_m2": 2.5,
      "price_per_room": 35,
      "price_per_bathroom": 50,
      "minutes_per_m2": 4,
      "minutes_per_room": 25,
      "minutes_per_bathroom": 40,
      "minimum_price": 220
    },
    "move_out_cleaning": {
      "label": "Move-out cleaning",
      "base_fee": 180,
      "price_per_m2": 4.2,
      "price_per_room": 55,
      "price_per_bathroom": 80,
      "minutes_per_m2": 5,
      "minutes_per_room": 35,
      "minutes_per_bathroom": 55,
      "minimum_price": 420
    },
    "office_cleaning": {
      "label": "Office cleaning",
      "base_fee": 90,
      "price_per_m2": 1.8,
      "price_per_room": 15,
      "price_per_bathroom": 40,
      "minutes_per_m2": 2,
      "minutes_per_room": 10,
      "minutes_per_bathroom": 30,
      "minimum_price": 180
    },
    "construction_cleaning": {
      "label": "Construction cleaning",
      "base_fee": 250,
      "price_per_m2": 6.5,
      "price_per_room": 60,
      "price_per_bathroom": 90,
      "minutes_per_m2": 7,
      "minutes_per_room": 40,
      "minutes_per_bathroom": 60,
      "minimum_price": 550
    },
    "window_cleaning": {
      "label": "Window cleaning",
      "base_fee": 80,
      "price_per_m2": 5,
      "price_per_room": 0,
      "price_per_bathroom": 0,
      "minutes_per_m2": 6,
      "minutes_per_room": 0,
      "minutes_per_bathroom": 0,
      "minimum_price": 150
    }
  },

  "urgency_rules": {
    "flexible": {
      "label": "Flexible date",
      "multiplier": 1.0,
      "fixed_fee": 0
    },
    "standard": {
      "label": "Within 7 days",
      "multiplier": 1.05,
      "fixed_fee": 0
    },
    "urgent": {
      "label": "Within 48 hours",
      "multiplier": 1.15,
      "fixed_fee": 30
    },
    "same_day": {
      "label": "Same day",
      "multiplier": 1.3,
      "fixed_fee": 60
    },
    "weekend": {
      "label": "Weekend",
      "multiplier": 1.2,
      "fixed_fee": 40
    }
  },

  "condition_rules": {
    "light": {
      "label": "Light cleaning needed",
      "multiplier": 0.9
    },
    "normal": {
      "label": "Normal condition",
      "multiplier": 1.0
    },
    "heavy": {
      "label": "Very dirty or neglected",
      "multiplier": 1.25
    },
    "unknown": {
      "label": "Condition unknown",
      "multiplier": 1.1
    }
  },

  "addons": {
    "oven": {
      "label": "Oven cleaning",
      "price": 80,
      "minutes": 45
    },
    "fridge": {
      "label": "Fridge cleaning",
      "price": 45,
      "minutes": 25
    },
    "extractor_hood": {
      "label": "Extractor hood cleaning",
      "price": 50,
      "minutes": 30
    },
    "balcony": {
      "label": "Balcony cleaning",
      "price": 70,
      "minutes": 45
    },
    "inside_windows": {
      "label": "Inside window cleaning",
      "price": 90,
      "minutes": 60
    },
    "blinds": {
      "label": "Blinds cleaning",
      "price": 80,
      "minutes": 50
    }
  },

  "pricing_formula": {
    "base_price": "base_fee + area_m2 * price_per_m2 + rooms * price_per_room + bathrooms * price_per_bathroom + addon_prices",
    "final_price": "max(base_price * urgency_multiplier * condition_multiplier + urgency_fixed_fee, minimum_price)",
    "estimated_minutes": "area_m2 * minutes_per_m2 + rooms * minutes_per_room + bathrooms * minutes_per_bathroom + addon_minutes",
    "estimated_hours": "estimated_minutes / 60",
    "price_range_low": "final_price * 0.9",
    "price_range_high": "final_price * 1.1"
  },

  "sample_input": {
    "service_type": "move_out_cleaning",
    "area_m2": 75,
    "rooms": 3,
    "bathrooms": 1,
    "urgency": "standard",
    "condition": "normal",
    "addons": ["oven", "blinds"],
    "email": "customer@example.com",
    "preferred_date": "2026-05-29",
    "postcode": "8001"
  },

  "sample_output": {
    "service_type": "move_out_cleaning",
    "estimated_price_chf": 758,
    "price_range_chf": {
      "low": 682,
      "high": 834
    },
    "estimated_hours": 8.7,
    "needs_photos": false,
    "message_for_caller": "Based on the information you gave me, the estimated price is around CHF 680 to CHF 830. The job should take around 9 hours. The final price may change after checking the exact condition of the property."
  },

  "photo_rules": {
    "needs_photos_if": [
      "condition is heavy",
      "condition is unknown",
      "service_type is construction_cleaning",
      "area_m2 is greater than 150",
      "addons include balcony and area is unknown"
    ]
  }
}