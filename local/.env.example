# Copy to local/.env and fill in real values.
# local/.env is gitignored.

# Absolute path to the Google Service Account JSON key file.
# Generated at console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_APPLICATION_CREDENTIALS=C:\SideQuest\ColuseumHack\local\credentials\service-account.json

# Calendar IDs for the demo crews. Format: abc123@group.calendar.google.com
# Found in: Google Calendar → calendar settings → Integrate calendar → Calendar ID.
# The service account must be shared into each calendar as "Make changes to events".
CALENDAR_ID_CREW_ZH_1=
CALENDAR_ID_CREW_ZH_2=
