# Atrium local/deploy settings
AWS_REGION=us-west-2
AWS_PROFILE=

# Tenant demo defaults
COMPANY_ID=glanz-ag
COMPANY_NAME=Glanz AG
PERSONA_NAME=Sarah
DEFAULT_LOCALE=de-CH
DEFAULT_CURRENCY=CHF
DEFAULT_UNIT_SYSTEM=metric
DEFAULT_TIMEZONE=Europe/Zurich

# Deployed resource names/ids are written by scripts as they become available.
CALLS_TABLE=atrium-calls
BOOKINGS_TABLE=atrium-bookings
COMPANIES_TABLE=atrium-companies
CREWS_TABLE=atrium-crews
PRICE_MATRIX_TABLE=atrium-price-matrix
KB_BUCKET=
BEDROCK_KB_ID=

# Phase 1 voice loop config (Transcribe + Claude + Polly — no Nova Sonic).
TRANSCRIBE_LANGUAGE_CODE=en-US
POLLY_VOICE_ID=Joanna
BRAIN_FUNCTION_NAME=
BRAIN_MODEL_ID=us.anthropic.claude-sonnet-4-6
EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# DB backend toggle for the slot adapter.
#   mock  — in-memory (default; safe for `npm run build` and local sims)
#   real  — delegate to lambdas/input_agent/ddb.py (owned by the data team)
DDB_BACKEND=mock

# Live Call Wall (web/) — Vite reads VITE_* at build time.
# Leave unset to run in mock/simulated mode.
VITE_AUDIO_WS_URL=
VITE_WALL_WS_URL=
VITE_WALL_API_URL=
VITE_COMPANY_ID=glanz-ag
VITE_COMPANY_NAME=Glanz AG
