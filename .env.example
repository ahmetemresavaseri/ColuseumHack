# Atrium local/deploy settings
AWS_REGION=us-west-2
AWS_PROFILE=

# Tenant demo defaults
COMPANY_ID=glanz-ag
COMPANY_NAME=Glanz AG
PERSONA_NAME=Sarah
DEFAULT_LOCALE=de-CH
DEFAULT_CURRENCY=CHF
DEFAULT_UNIT_SYSTEM=metric
DEFAULT_TIMEZONE=Europe/Zurich

# DynamoDB tables (CDK fills these in at deploy time; defaults match data_stack).
CALLS_TABLE=atrium-calls
BOOKINGS_TABLE=atrium-bookings
COMPANIES_TABLE=atrium-companies
CREWS_TABLE=atrium-crews
PRICE_MATRIX_TABLE=atrium-price-matrix
KNOWLEDGE_ITEMS_TABLE=atrium-knowledgeitems
KB_BUCKET=
BEDROCK_KB_ID=

# Input Agent backend toggle:
#   real — Lambda hits DynamoDB (default in deployed lambda_stack)
#   mock — in-memory; used by tests and local sims
DDB_BACKEND=mock

# Brain
BRAIN_FUNCTION_NAME=
BRAIN_MODEL_ID=us.anthropic.claude-sonnet-4-6
EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3

# Optional Phase 1 voice loop (Transcribe + Polly only used by browser fallback)
TRANSCRIBE_LANGUAGE_CODE=en-US
POLLY_VOICE_ID=Joanna

# AppSync (primary live transport for the Wall). Filled in after `cdk deploy`.
VITE_APPSYNC_GRAPHQL_URL=
VITE_APPSYNC_API_KEY=

# Optional polling fallback (Wall REST endpoint).
VITE_WALL_API_URL=
VITE_WALL_WS_URL=

# Connect demo number to display on the Wall.
VITE_CONNECT_PHONE_NUMBER=

# Tenant identifiers the Wall subscribes to.
VITE_COMPANY_ID=glanz-ag
VITE_COMPANY_NAME=Glanz AG

# Optional browser-mic fallback (NOT the primary demo path).
VITE_AUDIO_WS_URL=
